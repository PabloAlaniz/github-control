# Every variable here is OPTIONAL when self-hosting (Docker / Node).
# With none set, the app opens a setup wizard on first start and stores the
# answers in <DATA_DIR>/config.json. Anything you set here wins over the
# wizard and is not asked for.
#
# Copy to .env to use with `docker compose` (it reads .env automatically).

# --- Storage ---
# sqlite      -> one database file under <DATA_DIR> (recommended)
# json | csv  -> files under <DATA_DIR>/storage (default when nothing is set: json)
# postgres    -> needs DATABASE_URL; the schema is created automatically
STORAGE_DRIVER=
DATABASE_URL=

# --- GitHub ---
# Personal access token (repo scope) and, optionally, organizations to include.
GITHUB_TOKEN=
GITHUB_ORGS=

# --- Sign-in ---
# The wizard stores a password hash instead; AUTH_PASSWORD is plain text.
AUTH_USERNAME=
AUTH_PASSWORD=
# Generated and saved automatically when missing.
JWT_SECRET=
API_KEY=
# Do NOT bake API_KEY into the frontend build (VITE_API_KEY): Vite inlines it
# into the public JS bundle, so anyone who can load the page can read it.

# --- Sync ---
# Hours between automatic full syncs (0 disables). Default 24.
SYNC_INTERVAL_HOURS=

# --- Service checks and alerts ---
# Minutes between health checks of the registered services (1-1440). Default 15.
SERVICE_CHECK_MINUTES=
# A high or medium priority repo with no commits for this many days raises an alert (0 = off). Default 90.
ALERT_STALE_DAYS=
# A repo whose health score is under this raises an alert (0 = off). Default 40.
ALERT_HEALTH_BELOW=
# Where alerts are sent (Slack, Discord, Telegram, ntfy, webhooks) is set up on the Alerts page.

# --- Optional features ---
# Public SVG badges for public repos at /api/badges/<owner>/<repo>/<metric>.svg
PUBLIC_BADGES=
# Repo settings every repo is expected to have, as JSON. Unset uses a small default set.
# Example: {"delete_branch_on_merge":true,"allow_merge_commit":false,"has_wiki":false}
REPO_BASELINE=
# AI summaries
ANTHROPIC_API_KEY=
# Token CI uses to report coverage
CI_COVERAGE_TOKEN=

# --- Demo ---
# Serves a fictional dataset from memory: no wizard, no sign-in, no GitHub token.
# true = visitors can edit local data; readonly = nothing can be changed (public demos).
# DEMO=true
# Minutes between reloads of the dataset (0 never reloads). Default 60.
# DEMO_RESET_MINUTES=

# --- Local development only ---
# Skips sign-in entirely. Never use on a reachable server.
# DISABLE_AUTH=true
